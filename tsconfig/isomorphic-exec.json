{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./isomorphic.json",
  "compilerOptions": {
    "noImplicitAny": true,
    "importHelpers": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "target": "ES2023",
  },
}
